HOST=127.0.0.1
PORT=8080

# Base URL of the upstream API this proxy forwards to.
# Requests to this proxy's /v1/* paths are forwarded to <UPSTREAM_BASE_URL>/*
UPSTREAM_BASE_URL=https://sg1-9682fffda636.shinsengumi.my.id/v1
UPSTREAM_API_KEY=
TELEGRAM_BOT_TOKEN=
CASHI_API_KEY=
CASHI_SECRET_KEY=
DEFAULT_MODEL_PRICE=400
MODEL_PRICE_MARKUP=1.25
USAGE_DB_PATH=./data/users.json
# Billing: ask the upstream for token usage on streaming chat/completions
# (adds stream_options.include_usage). Set to false only if the upstream rejects that field.
FORCE_STREAM_USAGE=true


# --- Split hosting (server.js and telegram-bot.js on different hosts) ---
# Same long random value on BOTH hosts. Enables server.js's /internal/rpc data API.
INTERNAL_API_SECRET=
# Bot host only: base URL of the host running server.js (no /v1). Leave empty when both run on one host.
DATA_API_URL=

# --- Admin stats Mini App (Admin Panel -> Stats Mini App) ---
# Bot host: public HTTPS address of server.js's /admin/app page, e.g. https://stats.example.com/admin/app
# Telegram only opens Mini Apps over HTTPS. Empty = the button shows these setup steps instead.
# server.js also needs TELEGRAM_BOT_TOKEN (above, same bot token) to verify that the admin opened it.
ADMIN_MINI_APP_URL=
